PREFS = PROFILE / "Default/Preferences"
LOCAL_STATE = PROFILE / "Local State"
STATUS = Path.home() / ".no-leak-helium/status.txt"
POLICY_DIR = PROFILE / "policies/managed"
POLICY_JSON = POLICY_DIR / "privacy.json"
STAGED_MANAGED = Path.home() / ".no-leak-helium/net.imput.helium.managed.plist"
APP = Path("/Applications/Helium.app")
ADBLOCK_ID = "gighmmpiobklfepjocnamgkkbiglidom"
UBO_ID = "cjpalhdlnbpafiamejdnhcphjbkeiagm"
UBO_CRX = Path.home() / ".local/share/ublock/uBlock0_1.75.0.chromium.crx"
UBO_VERSION = "1.75.0"
BMS_ID = "occkalmjgdilhnphpbjopodjkpppcddj"
BMS_SHARE = Path.home() / ".local/share/no-leak-helium/browser-management"
GITHUB_LATEST = "https://api.github.com/repos/imputnet/helium-macos/releases/latest"
